FROM python
ARG PPOSTGRES_USER=user
ARG POSTGRES_PASSWORD=12345678
ARG PPOSTGRES_DB=users
ARG POSTGRES_SERVER_NAME=db

ENV POSTGRES_SERVER_NAME=POSTGRES_SERVER_NAME
ENV PPOSTGRES_USER=PPOSTGRES_USER
ENV POSTGRES_PASSWORD=POSTGRES_PASSWORD
ENV PPOSTGRES_DB=PPOSTGRES_DB

WORKDIR /app
COPY . .
RUN pip install -r requirements.txt

EXPOSE 5000


CMD ["python","app.py"]